[Unit]
Description=MuxCore Module - call-policy-default
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=muxcore
Group=muxcore
WorkingDirectory=/var/lib/call-policy-default
Environment=CALL_POLICY_FILE=/var/lib/call-policy-default/policies.yaml
ExecStart=/usr/local/bin/call-policy-default \
  --muxcore-mesh-addr localhost:9090 \
  --muxcore-module-id call-policy-default
Restart=on-failure
RestartSec=5
LimitNOFILE=65536

; Security hardening
CapabilityBoundingSet=
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/call-policy-default

[Install]
WantedBy=multi-user.target
